# Backend configuration. Copy to .env for local development; never commit .env.
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=true

# Optional AI-written notes. Leave LLM_PROVIDER=none to use the built-in rules generator.
LLM_PROVIDER=none
GROQ_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

MAX_UPLOAD_BYTES=1000000
DEFAULT_PAGE_SIZE=20
